{
  "name": "@agent-runner/controller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agent-runner": "dist/src/cli.js",
    "requirements-builder": "dist/src/requirements/cli.js"
  },
  "description": "Project-agnostic controller and reliability simulator for coding-agent work.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build --silent && node --test dist/test/*.test.js",
    "verify": "npm run check && npm test",
    "validate:fixture": "npm run build --silent && node dist/src/cli.js validate fixtures/project/.agent-runner.yml",
    "smoke:fable": "npm run build --silent && node dist/src/smoke-fable.js"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
